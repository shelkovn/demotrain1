<Window x:Class="demo1.Windows.BrowsingWindow.BrowsingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo1.Windows.BrowsingWindow"
        xmlns:elements="clr-namespace:demo1.Elements"
        mc:Ignorable="d" FontFamily="Times New Roman"
        Title="Просмотр товаров" Height="450" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Button x:Name="ToAuth" Content="Выйти" Click="ToAuth_Click" Width="100" HorizontalAlignment="Left" Margin="5" Background="#00fa9a"/>
        <Label x:Name="UsernameLabel" HorizontalAlignment="Right"/>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <elements:ItemCard/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            
            </ItemsControl>
        </ScrollViewer>
    </Grid>
    
</Window>
