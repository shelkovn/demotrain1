<Window x:Class="demo1.Windows.BrowsingWindow.BrowsingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo1.Windows.BrowsingWindow"
        xmlns:elements="clr-namespace:demo1.Elements"
        mc:Ignorable="d" FontFamily="Times New Roman"
        Title="Просмотр товаров" Height="450" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Button x:Name="ToAuth" Content="Выйти" Click="ToAuth_Click" Width="100" HorizontalAlignment="Left" Margin="5" Background="#00fa9a"/>
        <Label x:Name="UsernameLabel" HorizontalAlignment="Right"/>

        <Label Content="Поиск" Grid.Row="1"/>
        <TextBox x:Name="SearchBar" Width="400" Grid.Row="1" TextChanged="SearchBar_TextChanged"/>

        <TextBlock x:Name="SelectedLabel" Text="Выберите товар"  Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Grid.Row="2" >
            <Button x:Name="AddButton" Content="Добавить товар" Click="AddButton_Click" Grid.Row="2" Width="100"  Margin="5"/>
        </StackPanel>

        <ListView x:Name="ProductList" SelectionChanged="ProductList_SelectionChanged" Grid.Row="3">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <elements:ItemCard/>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
    
</Window>
