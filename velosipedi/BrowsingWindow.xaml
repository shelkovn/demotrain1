<Window x:Class="velosipedi.BrowsingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:velosipedi"
        xmlns:elem="clr-namespace:velosipedi.Elements"
        mc:Ignorable="d"
        Title="Просмотр товаров" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" x:Name="SearchbarPanel">
            <Label Content="Поиск"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" MinWidth="100"/>
            <ComboBox x:Name="AmountSort" SelectionChanged="AmountSort_SelectionChanged" SelectedIndex="0">
                <TextBlock>Не сортировать по наличию</TextBlock>
                <TextBlock>По возрастанию количества</TextBlock>
                <TextBlock>По убыванию количества</TextBlock>
            </ComboBox>

            <ComboBox x:Name="PriceSort" SelectionChanged="PriceSort_SelectionChanged" SelectedIndex="0">
                <TextBlock>Не сортировать по цене</TextBlock>
                <TextBlock>По возрастанию цены</TextBlock>
                <TextBlock>По убыванию цены</TextBlock>
            </ComboBox>

            <ComboBox x:Name="DiscountSort" SelectionChanged="DiscountSort_SelectionChanged" SelectedIndex="0">
                <TextBlock>Не сортировать по скидке</TextBlock>
                <TextBlock>По возрастанию скидки</TextBlock>
                <TextBlock>По убыванию скидки</TextBlock>
            </ComboBox>

            <ComboBox x:Name="DiscountRange" SelectionChanged="DiscountRange_SelectionChanged" SelectedIndex="0">
                <TextBlock>Все диапазоны</TextBlock>
                <TextBlock>0-11.99%</TextBlock>
                <TextBlock>12-18.99%</TextBlock>
                <TextBlock>19-100%</TextBlock>
            </ComboBox>
        </StackPanel>

        <StackPanel x:Name="EditorPanel" Grid.Row="1" Orientation="Horizontal">
            <Label x:Name="SelectionLabel" Content="Не выбрано" MinWidth="200"/>
            <Button x:Name="EditButton" Content="Редактировать" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click"/>
            <Button x:Name="AddButton" Content="Добавить товар" Margin="50,0,0,0" Click="AddButton_Click"/>
        </StackPanel>

        <ListView x:Name="ItemList" Grid.Row="2" SelectionChanged="ItemList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <elem:ItemCard/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
