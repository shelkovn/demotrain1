<Window x:Class="velosipedi.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:velosipedi"
        mc:Ignorable="d"
        Title="Редактирование товара" Height="450" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label x:Name="IdLabel" Content="ID:" Grid.Row="10" Grid.Column="0"/>
        <TextBox x:Name="IdTextBox" Text="{Binding Article}" Grid.Row="10" Grid.Column="1" IsReadOnly="True"/>
        
        <Label x:Name="ArticleLabel" Content="Артикул:" Grid.Row="8" Grid.Column="0"/>
        <TextBox x:Name="ArticleTextBox" Text="{Binding Article}" Grid.Row="8" Grid.Column="1"/>

        <Label Content="Наименование товара:" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="NameTextBox" Text="{Binding Name}" Grid.Row="0" Grid.Column="1"/>

        <Label Content="Категория товара:" Grid.Row="1" Grid.Column="0"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="1" Grid.Column="1"
              DisplayMemberPath="CategoryName" 
              SelectedValuePath="CategoryId"
              SelectedValue="{Binding CategoryId}"/>

        <Label Content="Описание товара:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,8,10,5"/>
        <TextBox x:Name="DescriptionTextBox" Text="{Binding Description}" Grid.Row="2" Grid.Column="1"
             Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Stretch"/>

        <Label Content="Производитель:" Grid.Row="3" Grid.Column="0"/>
        <ComboBox x:Name="ManufacturerComboBox" Grid.Row="3" Grid.Column="1"
              DisplayMemberPath="ManufacturerName" 
              SelectedValuePath="DealerId"
              SelectedValue="{Binding ManufacturerId}"/>

        <Label Content="Поставщик:" Grid.Row="4" Grid.Column="0"/>
        <ComboBox x:Name="ProviderComboBox" Grid.Row="4" Grid.Column="1"
              DisplayMemberPath="DealerName" 
              SelectedValuePath="DealerId"
              SelectedValue="{Binding DealerId}"/>

        <Label Content="Цена:" Grid.Row="5" Grid.Column="0"/>
        <TextBox x:Name="PriceTextBox" Text="{Binding Price}" Grid.Row="5" Grid.Column="1"/>

        <Label Content="Количество на складе:" Grid.Row="6" Grid.Column="0"/>
        <TextBox x:Name="CountTextBox" Text="{Binding AmountInStock}" Grid.Row="6" Grid.Column="1"/>

        <Label Content="Действующая скидка (%):" Grid.Row="7" Grid.Column="0"/>
        <TextBox x:Name="DiscountTextBox" Text="{Binding CurrentDiscount}" Grid.Row="7" Grid.Column="1"/>

        <Button Content="Выбрать изображение" x:Name="ImageButton" Click="ImageButton_Click" Grid.Row="9"/>
        <Image x:Name="PreviewImage"/>

        <Button Grid.Row="11" x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click"  Width="100" Height="30" Margin="0,0,10,0" IsDefault="True"/>

        <Button Grid.Row="11" Grid.Column="1" x:Name="CancelButton" Content="Отменить" Click="CancelButton_Click"  Width="100" Height="30"/>
    </Grid>
</Window>
